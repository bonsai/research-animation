@startuml
title AIアニメ映画制作システム
Reference / Generation / Eval-JEV / TPS-Gate
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

package "REFERENCE" as REF {
  artifact "TEXT
ideas / scripts / screenplays" as TEXT
  artifact "YAML
configuration / canon" as YAML
  artifact "PNG
sketches / photos / images" as PNG
  artifact "HTML
character sheets" as HTML
  artifact "SVG
storyboards / comics" as SVG
  database "RAG
chunk index" as RAG
  note bottom of RAG
    RAG is for retrieval.
    Structured data remains
    the source of truth.
  end note
}

component "GENERATION
model + recipe + run record
candidate assets" as GEN
component "EVAL / JEV
proposition + evidence + rubric
score + confidence + verdict" as EVAL

package "PRODUCTION SYSTEM / TPS-Gate" as TPS {
  usecase "Gate A
Spec / Reference readiness" as A
  usecase "Gate B
Asset inspection" as B
  usecase "Gate C
Shot inspection" as C
  usecase "Gate D
Delivery inspection" as D
  A --> B
  B --> C
  C --> D
}

artifact "Accepted assets
and finished film" as OUT
component "Revision routing
return to the cause stage" as REV

REF --> GEN : approved context + spec
GEN --> EVAL : candidate + generation record
EVAL --> TPS : pass
EVAL --> REV : revise / reject / human review
REV --> GEN : generation defect
REV --> REF : canon / reference defect
REV --> EVAL : unclear rubric / evidence
TPS --> OUT : gates passed
TPS ..> EVAL : traceability + KPI feedback

note bottom of TPS
  Stop and fix at source.
  Avoid indiscriminate regeneration.
  Reduce waiting, rework and waste.
end note
@enduml
